{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resonote",
  "version": "0.2.1",
  "identifier": "app.resonote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Resonote",
        "width": 420,
        "height": 620,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright © 2026 Resonote contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "A resource-conscious local recorder for microphone and system audio with on-device speech transcription.",
    "shortDescription": "Local audio recording and transcription",
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
